return {
	{
		"MeanderingProgrammer/render-markdown.nvim",
		event = "BufReadPost",
		dependencies = { "nvim-treesitter/nvim-treesitter", "nvim-tree/nvim-web-devicons" },
		opts = {
			enabled = true,
			file_types = { "markdown" },
			render_modes = { "n", "c" },
			match_conceal = true,
			replay_fold = true,
			win_options = {
				conceallevel = {
					rendered = 2,
					conceal = 0,
				},
			},
			heading = {
				enabled = true,
				sign = true,
				position = "overlay",
				icons = { "", "", "", "", "", "" },
				signs = { "1", "2", "3", "4", "5", "6" },
				width = "full",
